{
  "functions": {
    "api/event/[id].js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/event/:id",   "destination": "/api/event/:id" },
    { "source": "/api/:path*",  "destination": "/api/:path*" },
    { "source": "/(.*)",        "destination": "/" }
  ]
}
